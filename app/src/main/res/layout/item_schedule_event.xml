<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="0dp"
    app:cardBackgroundColor="#BBDEFB"
    app:cardCornerRadius="4dp"
    app:cardElevation="1dp"
    app:contentPadding="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/eventBody"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Accent bar; body fill is a lighter shade of the same color -->
            <View
                android:id="@+id/eventColorBar"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@android:color/holo_blue_light" />

            <LinearLayout
                android:id="@+id/eventTextContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/tvEventTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="STUDY OR PLAN"
                    android:textColor="@android:color/black"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEventTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="8:30 - 10:00 AM"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Larger hit targets; visible grip bars stay thin -->
        <FrameLayout
            android:id="@+id/resizeHandleTop"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_gravity="top"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_gravity="center"
                android:alpha="0.55"
                android:background="#66000000" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/resizeHandleBottom"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_gravity="bottom"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_gravity="center"
                android:alpha="0.55"
                android:background="#66000000" />
        </FrameLayout>
    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
