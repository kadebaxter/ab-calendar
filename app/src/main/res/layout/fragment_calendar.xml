<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fragment_background">

    <!-- Day view: selector + hour schedule -->
    <LinearLayout
        android:id="@+id/dayViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDaySelector"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/day_selector_background"
            android:clipToPadding="false"
            android:elevation="4dp"
            android:overScrollMode="never"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <LinearLayout
            android:id="@+id/llAllDayEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/day_selector_background"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

        <!-- Clip at the ScrollView edge so cards never paint over the date strip.
             Hour-row overflow inside the grid still works via llDaySchedule. -->
        <com.example.calendarnotes.ui.DayScheduleScrollView
            android:id="@+id/svDaySchedule"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/fragment_background"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llDaySchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </com.example.calendarnotes.ui.DayScheduleScrollView>
    </LinearLayout>

    <!-- Week / month view -->
    <LinearLayout
        android:id="@+id/weekMonthContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/monthViewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/weekdayHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMonthGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAgenda"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tvAgendaEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/no_events_in_range"
                android:textColor="@android:color/darker_gray"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
